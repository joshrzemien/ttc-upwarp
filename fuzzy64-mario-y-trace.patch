     writeb(write_rdram_fb, &g_dev.dp, *memory_address(), *memory_wbyte());
 }
 
 void write_rdramFBh(void)
 {
+    trace_mario_y_write("fb_u16", *memory_address(), *memory_whword(), 2);
     writeh(write_rdram_fb, &g_dev.dp, *memory_address(), *memory_whword());
 }
 
