+#define MARIO_Y_TARGET UINT32_C(0x00339e40)
+#define MARIO_Y_CONTEXT_SIZE 64
+
+struct mario_y_instruction_context
+{
+    uint64_t sequence;
+    uint32_t pc;
+    uint32_t opcode;
+    uint8_t rs;
+    uint8_t rt;
+    uint8_t fs;
+    uint8_t ft;
+    uint8_t fd;
+    uint64_t gpr_rs;
+    uint64_t gpr_rt;
+    uint64_t fpr_fs;
+    uint64_t fpr_ft;
+    uint64_t fpr_fd;
+    uint32_t fpr_ft_single;
+};
+
+static struct mario_y_instruction_context mario_y_context[MARIO_Y_CONTEXT_SIZE];
+static uint64_t mario_y_instruction_count;
+static uint64_t mario_y_event_count;
+static unsigned int mario_y_context_position;
+static int mario_y_trace_state = -1;
+static const char* mario_y_trace_origin = "CPU";
+
+void trace_mario_y_set_origin(const char* origin)
+{
+    mario_y_trace_origin = origin == NULL ? "CPU" : origin;
+}
+
+static int mario_y_trace_enabled(void)
+{
+    if (mario_y_trace_state < 0)
+        mario_y_trace_state = getenv("TRACE_MARIO_Y") != NULL;
+    return mario_y_trace_state;
+}
+
+void trace_mario_y_instruction(uint32_t pc, uint32_t opcode)
+{
+    struct mario_y_instruction_context* context;
+    int64_t* gpr;
+    int64_t* fpr;
+    float** fpr_single;
+
+    if (!mario_y_trace_enabled())
+        return;
+
+    context = &mario_y_context[mario_y_context_position];
+    gpr = r4300_regs();
+    fpr = r4300_cp1_regs();
+    fpr_single = r4300_cp1_regs_simple();
+    context->sequence = mario_y_instruction_count++;
+    context->pc = pc;
+    context->opcode = opcode;
+    context->rs = (opcode >> 21) & 31;
+    context->rt = (opcode >> 16) & 31;
+    context->fs = (opcode >> 11) & 31;
+    context->ft = (opcode >> 16) & 31;
+    context->fd = (opcode >> 6) & 31;
+    context->gpr_rs = (uint64_t)gpr[context->rs];
+    context->gpr_rt = (uint64_t)gpr[context->rt];
+    context->fpr_fs = (uint64_t)fpr[context->fs];
+    context->fpr_ft = (uint64_t)fpr[context->ft];
+    context->fpr_fd = (uint64_t)fpr[context->fd];
+    memcpy(&context->fpr_ft_single, fpr_single[context->ft],
+           sizeof(context->fpr_ft_single));
+    mario_y_context_position = (mario_y_context_position + 1) % MARIO_Y_CONTEXT_SIZE;
+}
+
+uint32_t trace_mario_y_word(void)
+{
+    uint32_t value;
+    read_rdram_dram(&g_dev.ri, MARIO_Y_TARGET, &value);
+    return value;
+}
+
+static void dump_mario_y_context(uint64_t event)
+{
+    unsigned int available = mario_y_instruction_count < MARIO_Y_CONTEXT_SIZE
+                           ? (unsigned int)mario_y_instruction_count
+                           : MARIO_Y_CONTEXT_SIZE;
+    int age;
+
+    for (age = (int)available - 1; age >= 0; --age)
+    {
+        unsigned int index =
+            (mario_y_context_position + MARIO_Y_CONTEXT_SIZE - 1 - age)
+            % MARIO_Y_CONTEXT_SIZE;
+        const struct mario_y_instruction_context* context = &mario_y_context[index];
+        fprintf(stderr,
+                "MARIO_Y_CONTEXT,event=%llu,age=%d,sequence=%llu,pc=%08x,"
+                "opcode=%08x,rs=%u,rt=%u,fs=%u,ft=%u,fd=%u,"
+                "gpr_rs=%016llx,gpr_rt=%016llx,fpr_fs=%016llx,"
+                "fpr_ft=%016llx,fpr_fd=%016llx,fpr_ft_single=%08x\n",
+                (unsigned long long)event,
+                age,
+                (unsigned long long)context->sequence,
+                context->pc,
+                context->opcode,
+                context->rs,
+                context->rt,
+                context->fs,
+                context->ft,
+                context->fd,
+                (unsigned long long)context->gpr_rs,
+                (unsigned long long)context->gpr_rt,
+                (unsigned long long)context->fpr_fs,
+                (unsigned long long)context->fpr_ft,
+                (unsigned long long)context->fpr_fd,
+                context->fpr_ft_single);
+    }
+}
+
+static int mario_y_range_overlaps(uint32_t destination,
+                                  unsigned int length,
+                                  unsigned int count,
+                                  unsigned int skip)
+{
+    unsigned int block;
+    for (block = 0; block < count; ++block)
+    {
+        uint64_t start = (uint64_t)destination
+                       + (uint64_t)block * (length + skip);
+        uint64_t end = start + length;
+        if (start < (uint64_t)MARIO_Y_TARGET + 4 && end > MARIO_Y_TARGET)
+            return 1;
+    }
+    return 0;
+}
+
+static void trace_mario_y_write(const char* width,
+                                uint32_t address,
+                                uint64_t value,
+                                unsigned int size)
+{
+    uint32_t physical = address & UINT32_C(0x1fffffff);
+    uint32_t old_word;
+    uint32_t new_word;
+    uint32_t mask = 0;
+    uint32_t write_bits = 0;
+    unsigned int byte;
+    uint64_t event;
+    const struct mario_y_instruction_context* context;
+    int16_t immediate;
+    uint32_t effective_address;
+
+    if (!mario_y_trace_enabled()
+        || physical >= MARIO_Y_TARGET + 4
+        || (uint64_t)physical + size <= MARIO_Y_TARGET)
+        return;
+
+    old_word = trace_mario_y_word();
+    for (byte = 0; byte < size; ++byte)
+    {
+        uint32_t byte_address = physical + byte;
+        if (byte_address >= MARIO_Y_TARGET && byte_address < MARIO_Y_TARGET + 4)
+        {
+            unsigned int source_shift = (size - 1 - byte) * 8;
+            unsigned int target_shift = (MARIO_Y_TARGET + 3 - byte_address) * 8;
+            mask |= UINT32_C(0xff) << target_shift;
+            write_bits |= ((uint32_t)(value >> source_shift) & UINT32_C(0xff))
+                        << target_shift;
+        }
+    }
+    new_word = (old_word & ~mask) | (write_bits & mask);
+    event = ++mario_y_event_count;
+    context = mario_y_instruction_count == 0
+            ? NULL
+            : &mario_y_context[
+                (mario_y_context_position + MARIO_Y_CONTEXT_SIZE - 1)
+                % MARIO_Y_CONTEXT_SIZE];
+    immediate = context == NULL ? 0 : (int16_t)context->opcode;
+    effective_address = context == NULL
+                      ? 0
+                      : (uint32_t)(context->gpr_rs + immediate);
+
+    fprintf(stderr,
+            "MARIO_Y_WRITE,event=%llu,origin=%s,width=%s,pc=%08x,opcode=%08x,"
+            "address=%08x,physical=%08x,effective=%08x,"
+            "old=%08x,new=%08x,xor=%08x,mask=%08x,value=%016llx,"
+            "rs=%u,rt=%u,base_gpr=%016llx,source_gpr=%016llx,"
+            "source_fpr=%016llx,source_fpr_single=%08x\n",
+            (unsigned long long)event,
+            mario_y_trace_origin,
+            width,
+            context == NULL ? 0 : context->pc,
+            context == NULL ? 0 : context->opcode,
+            address,
+            physical,
+            effective_address,
+            old_word,
+            new_word,
+            old_word ^ new_word,
+            mask,
+            (unsigned long long)value,
+            context == NULL ? 0 : context->rs,
+            context == NULL ? 0 : context->rt,
+            (unsigned long long)(context == NULL ? 0 : context->gpr_rs),
+            (unsigned long long)(context == NULL ? 0 : context->gpr_rt),
+            (unsigned long long)(context == NULL ? 0 : context->fpr_ft),
+            context == NULL ? 0 : context->fpr_ft_single);
+    dump_mario_y_context(event);
+    fflush(stderr);
+}
+
+void trace_mario_y_dma(const char* engine,
+                       uint32_t destination,
+                       unsigned int length,
+                       unsigned int count,
+                       unsigned int skip,
+                       uint32_t source,
+                       uint32_t old_word)
+{
+    uint64_t event;
+    uint32_t new_word;
+    const struct mario_y_instruction_context* context;
+
+    if (!mario_y_trace_enabled()
+        || !mario_y_range_overlaps(destination, length, count, skip))
+        return;
+
+    event = ++mario_y_event_count;
+    new_word = trace_mario_y_word();
+    context = mario_y_instruction_count == 0
+            ? NULL
+            : &mario_y_context[
+                (mario_y_context_position + MARIO_Y_CONTEXT_SIZE - 1)
+                % MARIO_Y_CONTEXT_SIZE];
+    fprintf(stderr,
+            "MARIO_Y_DMA,event=%llu,origin=%s,engine=%s,pc=%08x,opcode=%08x,"
+            "destination=%08x,length=%u,count=%u,skip=%u,source=%08x,"
+            "old=%08x,new=%08x,xor=%08x\n",
+            (unsigned long long)event,
+            mario_y_trace_origin,
+            engine,
+            context == NULL ? 0 : context->pc,
+            context == NULL ? 0 : context->opcode,
+            destination,
+            length,
+            count,
+            skip,
+            source,
+            old_word,
+            new_word,
+            old_word ^ new_word);
+    dump_mario_y_context(event);
+    fflush(stderr);
+}
+
 void write_rdram(void)
 {
+    trace_mario_y_write("u32", *memory_address(), *memory_wword(), 4);
     writew(write_rdram_dram, &g_dev.ri, *memory_address(), *memory_wword());
 }
 
 void write_rdramb(void)
 {
+    trace_mario_y_write("u8", *memory_address(), *memory_wbyte(), 1);
     writeb(write_rdram_dram, &g_dev.ri, *memory_address(), *memory_wbyte());
 }
 
 void write_rdramh(void)
 {
+    trace_mario_y_write("u16", *memory_address(), *memory_whword(), 2);
     writeh(write_rdram_dram, &g_dev.ri, *memory_address(), *memory_whword());
 }
 
 void write_rdramd(void)
 {
+    trace_mario_y_write("u64", *memory_address(), *memory_wdword(), 8);
     writed(write_rdram_dram, &g_dev.ri, *memory_address(), *memory_wdword());
 }
 
@@ -348,21 +609,25 @@ void read_rdramFBd(void)
 
 void write_rdramFB(void)
 {
+    trace_mario_y_write("fb_u32", *memory_address(), *memory_wword(), 4);
     writew(write_rdram_fb, &g_dev.dp, *memory_address(), *memory_wword());
 }
 
